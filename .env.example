# =============================================================
# Church Manager Core — Variáveis de Ambiente
# Copie este arquivo para .env: cp .env.example .env
# =============================================================

# Banco de dados (PostgreSQL)
DATABASE_URL=postgresql://church_erp:church_erp@localhost:5432/church_erp

# Backend
PORT=3000
NODE_ENV=development
JWT_SECRET=dev-jwt-secret-mude-em-producao
CSRF_SECRET=dev-csrf-secret-mude-em-producao
FIELD_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
LOG_LEVEL=info

# E-mail transacional (Resend)
# O domínio resend.dev serve apenas para testes enviados ao e-mail da conta
# Resend. Para enviar aos membros, use um remetente em domínio verificado.
EMAIL_PROVIDER=resend
RESEND_API_KEY=
EMAIL_FROM="Lumen <onboarding@resend.dev>"
EMAIL_REPLY_TO=
APP_PUBLIC_URL=http://localhost:5173
EMAIL_VERIFICATION_REQUIRED=false

# Storage (local = disco, cloud = Supabase/S3)
STORAGE_PROVIDER=local
UPLOAD_DIR=./uploads
