# =============================================================
# Church Manager Core — Variáveis de Ambiente
# Copie este arquivo para .env: cp .env.example .env
# =============================================================

# Banco de dados (PostgreSQL)
DATABASE_URL=postgresql://church_erp:church_erp@localhost:5432/church_erp

# Backend
PORT=3000
NODE_ENV=development
JWT_SECRET=dev-jwt-secret-mude-em-producao
CSRF_SECRET=dev-csrf-secret-mude-em-producao
FIELD_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
LOG_LEVEL=info

# Storage (local = disco, cloud = Supabase/S3)
STORAGE_PROVIDER=local
UPLOAD_DIR=./uploads
